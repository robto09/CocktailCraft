# IntelliJ / Android Studio
.idea/
/*.iml
*.hprof
*.DS_Store
*.log

# Kotlin specific caches
.kotlin
**/build/kotlin/
**/build/tmp/
**/build/intermediates/
**/build/outputs/
**/build/generated/
**/build/kotlin/compile*/

# iOS specific
# The generated project and its SPM Package.resolved are committed (IO-8);
# the Kotlin framework (shared/build/xcode-frameworks/) is a build artifact.
iosApp/DerivedData/
iosApp/*.xcodeproj/xcuserdata/
iosApp/*.xcodeproj/project.xcworkspace/xcuserdata/
# Includes build/DerivedData from `xcodebuild -derivedDataPath build/DerivedData`
iosApp/build/
# Leftovers from the CocoaPods setup in older checkouts — never commit
iosApp/Pods/
iosApp/CocktailCraft.xcworkspace/
*.ipa
*.dSYM.zip
*.dSYM

# Xcode
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Other system-specific files
.DS_Store
Thumbs.db

# Claude Code: shared config (.claude/settings.json, agents, commands) is
# committed; per-user settings and agent worktrees are not
.claude/worktrees/
.claude/settings.local.json

# Prebuilt iOS framework — build artifact, never commit
shared/shared.xcframework/
*.xcframework

# Generated codebase dumps and stray captures (AR-11) — never commit these
repomix-output*.md
/Screenshot_*.png
