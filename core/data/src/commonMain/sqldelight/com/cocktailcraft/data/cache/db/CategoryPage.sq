-- Schema changes need a migration: add src/commonMain/sqldelight/migrations/<N>.sqm
-- (N = current version, starting at 1) and regenerate the snapshot with
-- `./gradlew :core:data:generateCommonMainCocktailCraftDatabaseSchema`.
--
-- Which cocktails each category page lists, in the API's order, and when the
-- page was fetched. Ids only: the cocktails themselves are cached_cocktail
-- rows, joined in when the page is read. No foreign key: LRU/TTL eviction
-- may drop a listed cocktail, which then reads as a stale page.
-- Added in version 4 (migrations/3.sqm).
--
--   position    index in the filter.php response
--   fetched_at  epoch millis of the fetch that wrote the page (the same on
--               every row of a page); drives the refresh freshness check
CREATE TABLE category_page (
    category TEXT NOT NULL,
    cocktail_id TEXT NOT NULL,
    position INTEGER NOT NULL,
    fetched_at INTEGER NOT NULL,
    PRIMARY KEY (category, cocktail_id)
);

CREATE INDEX category_page_position ON category_page(category, position);

insert:
INSERT OR REPLACE INTO category_page(category, cocktail_id, position, fetched_at)
VALUES (?, ?, ?, ?);

deleteCategory:
DELETE FROM category_page WHERE category = ?;

-- The page's stored cocktails in API order. Listed ids whose cocktail row is
-- gone are skipped.
selectPage:
SELECT cached_cocktail.id, cached_cocktail.payload
FROM category_page
JOIN cached_cocktail ON cached_cocktail.id = category_page.cocktail_id
WHERE category_page.category = :category
ORDER BY category_page.position;

-- When the page was fetched (null if never), how many cocktails it lists and
-- how many of those are still cached.
pageStatus:
SELECT
    MIN(category_page.fetched_at) AS fetched_at,
    COUNT(*) AS listed,
    COUNT(cached_cocktail.id) AS stored
FROM category_page
LEFT JOIN cached_cocktail ON cached_cocktail.id = category_page.cocktail_id
WHERE category_page.category = :category;

hasPage:
SELECT COUNT(*) > 0 FROM category_page WHERE category = :category;
