-- Schema changes need a migration: add src/commonMain/sqldelight/migrations/<N>.sqm
-- (N = current version, starting at 1) and regenerate the snapshot with
-- `./gradlew :core:data:generateCommonMainCocktailCraftDatabaseSchema`.
--
-- Favorite cocktails (CocktailFavoritesRepositoryImpl).
--
--   payload   the Cocktail as JSON, so a favorite stays available offline no
--             matter what the offline cache evicts or expires (SH-4). NULL
--             for favorites imported from the old id-only Settings list until
--             the repository resolves them (cache first, then the API).
--   position  insertion order (1-based, increasing); favorites list in this
--             order, and upgrading a payload keeps an entry in place.
CREATE TABLE favorite_cocktail (
    id TEXT NOT NULL PRIMARY KEY,
    payload TEXT,
    position INTEGER NOT NULL
);

selectAll:
SELECT id, payload FROM favorite_cocktail ORDER BY position;

exists:
SELECT COUNT(*) FROM favorite_cocktail WHERE id = ?;

-- Appends a favorite; a no-op when the id is already a favorite (adding
-- updates the payload separately, see updatePayload). Also used by the
-- one-time import from Settings, where existing rows must win.
insertIfAbsent:
INSERT OR IGNORE INTO favorite_cocktail(id, payload, position)
VALUES (:id, :payload, (SELECT COALESCE(MAX(position), 0) + 1 FROM favorite_cocktail));

updatePayload:
UPDATE favorite_cocktail SET payload = :payload WHERE id = :id;

deleteById:
DELETE FROM favorite_cocktail WHERE id = ?;
