<?xml version="1.0" encoding="utf-8"?>
<!--
    Android-only strings that the OS reads straight from the app's resources:
    the launcher label, the widget picker names/descriptions and the static
    widget preview layouts. Everything the app itself renders (screens,
    dialogs, Glance widget content) lives in the shared :core:resources
    module (core/resources/src/commonMain/moko-resources) and is used via
    MR.strings (see util/SharedStrings.kt). Layouts may still reference those
    as @string/…, since that module's resources are merged into the app.
-->
<resources>
    <string name="app_name">CocktailCraft</string>

    <!-- Widget picker -->
    <string name="random_cocktail_widget_name">Random Cocktail</string>
    <string name="random_cocktail_widget_description">Discover a random cocktail and tap to view details in the app.</string>
    <string name="favorites_widget_name">Favorite Cocktails</string>
    <string name="favorites_widget_description">Quick access to your favorite cocktails.</string>

    <!-- Widget picker previews (sample content, see layout/*_widget_preview.xml) -->
    <string name="widget_preview_cocktail_name">Margarita</string>
    <string name="widget_preview_cocktail_category">Ordinary Drink</string>
    <string name="widget_preview_favorites_header">❤️ Favorites (3)</string>
    <string name="widget_preview_favorite_name_1">Mojito</string>
    <string name="widget_preview_favorite_name_2">Old Fashioned</string>
    <string name="widget_preview_favorite_category">Cocktail</string>
</resources>
