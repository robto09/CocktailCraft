<?xml version="1.0" encoding="utf-8"?>
<!--
    Mirrors the cross-platform design tokens in
    shared/designsystem/DesignTokens.kt (ColorTokens), the single source of
    truth for both platforms. These values only cover the pre-Compose window
    (cold start, status bar) and the home-screen widget assets — if the shared
    tokens change, update the matching entry here.
-->
<resources>
    <!-- ColorTokens.primaryLight / primaryDark (coral) -->
    <color name="cocktail_primary">#EB6A43</color>
    <color name="cocktail_primary_dark">#FF8A65</color>

    <!-- ColorTokens.secondaryLight / secondaryDark (gold) -->
    <color name="cocktail_secondary">#FFC84D</color>
    <color name="cocktail_secondary_dark">#FFD180</color>

    <!-- ColorTokens.backgroundLight / backgroundDark -->
    <color name="background_light">#FAFAFA</color>
    <color name="background_dark">#121212</color>

    <!-- ColorTokens.surfaceLight / surfaceDark -->
    <color name="surface_light">#FFFFFF</color>
    <color name="surface_dark">#1E1E1E</color>

    <!-- ColorTokens.textPrimaryLight / textPrimaryDark -->
    <color name="text_primary_light">#000000</color>
    <color name="text_primary_dark">#FFFFFF</color>

    <!-- ColorTokens.textSecondaryLight / textSecondaryDark -->
    <color name="text_secondary_light">#8E8E93</color>
    <color name="text_secondary_dark">#B0B0B0</color>

    <!-- ColorTokens status colors (success / error / warning) -->
    <color name="success">#34C759</color>
    <color name="error">#FF3B30</color>
    <color name="warning">#FF9500</color>

    <!-- System Colors -->
    <color name="black">#000000</color>
    <color name="white">#FFFFFF</color>
</resources>
