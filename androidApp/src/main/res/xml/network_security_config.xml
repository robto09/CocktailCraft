<?xml version="1.0" encoding="utf-8"?>
<!-- Platform defaults: HTTPS only, system CAs. No certificate pinning, on
     purpose. TheCocktailDB is a public, unauthenticated API (no credentials
     or user data go to it), so a pin protects nothing secret, while pinning
     the CA pool its CDN (Cloudflare) picks and rotates on its own schedule
     risks the app losing the network whenever that pool changes. The same
     holds on iOS, which has no pins either. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
