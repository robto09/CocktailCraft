<?xml version="1.0" encoding="utf-8"?>
<!-- Launchers before Android 12 ignore the API 31 sizing and preview
     attributes (hence tools:targetApi) and size the widget from
     minWidth/minHeight. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="31"
    android:minWidth="180dp"
    android:minHeight="180dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="530dp"
    android:maxResizeHeight="530dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_loading"
    android:previewLayout="@layout/random_cocktail_widget_preview"
    android:description="@string/random_cocktail_widget_description"
    android:widgetCategory="home_screen" />

