<?xml version="1.0" encoding="utf-8"?>
<!-- Backup/transfer rules for API 31+. Keep in sync with backup_rules.xml (API 24-30).
     cocktailcraft_prefs.xml is the plain Settings store. Credentials and profile PII no
     longer live there, but on installs upgraded from older versions it can still hold
     auth data, orders (with addresses) and the cocktail cache until the first launch
     moves them out, so it must never leave the device either.
     cocktailcraft_secure_prefs.xml is Keystore-encrypted; its master key is not backed
     up, so restored copies are unreadable and would only corrupt a fresh install.
     cocktailcraft_cache.db holds the offline cocktail cache and the cart, orders,
     favorites and reviews. SQLite keeps uncommitted and not-yet-checkpointed pages in
     the -wal/-shm (WAL mode) or -journal (rollback mode) files beside it, which
     carry the same data, so they are excluded with it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cocktailcraft_prefs.xml" />
        <exclude domain="sharedpref" path="cocktailcraft_secure_prefs.xml" />
        <exclude domain="database" path="cocktailcraft_cache.db" />
        <exclude domain="database" path="cocktailcraft_cache.db-wal" />
        <exclude domain="database" path="cocktailcraft_cache.db-shm" />
        <exclude domain="database" path="cocktailcraft_cache.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cocktailcraft_prefs.xml" />
        <exclude domain="sharedpref" path="cocktailcraft_secure_prefs.xml" />
        <exclude domain="database" path="cocktailcraft_cache.db" />
        <exclude domain="database" path="cocktailcraft_cache.db-wal" />
        <exclude domain="database" path="cocktailcraft_cache.db-shm" />
        <exclude domain="database" path="cocktailcraft_cache.db-journal" />
    </device-transfer>
</data-extraction-rules>
