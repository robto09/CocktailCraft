-- One row per cached cocktail. The full Cocktail is stored as JSON in
-- `payload`; the other columns exist so the cache can query, expire and evict
-- without decoding every row.
--
--   category       Cocktail.category, with blank values stored as NULL
--                  (entries cached before category stamping existed)
--   cached_at      epoch millis of the last write; drives the 24h TTL
--   last_accessed  epoch millis of the last read or write; drives LRU
--                  eviction. CocktailCache keeps it strictly increasing so
--                  rows written in the same millisecond keep a stable order.
CREATE TABLE cached_cocktail (
    id TEXT NOT NULL PRIMARY KEY,
    category TEXT,
    payload TEXT NOT NULL,
    cached_at INTEGER NOT NULL,
    last_accessed INTEGER NOT NULL
);

CREATE INDEX cached_cocktail_category ON cached_cocktail(category);

CREATE INDEX cached_cocktail_last_accessed ON cached_cocktail(last_accessed);

-- INSERT OR REPLACE rather than ON CONFLICT DO UPDATE: upsert syntax needs
-- SQLite 3.24, newer than the framework SQLite on minSdk 24 devices.
upsert:
INSERT OR REPLACE INTO cached_cocktail(id, category, payload, cached_at, last_accessed)
VALUES (?, ?, ?, ?, ?);

-- Used by the one-time import from the old Settings cache: rows already in the
-- database are newer than the legacy blob and must win.
insertIfAbsent:
INSERT OR IGNORE INTO cached_cocktail(id, category, payload, cached_at, last_accessed)
VALUES (?, ?, ?, ?, ?);

selectById:
SELECT payload, cached_at FROM cached_cocktail WHERE id = ?;

exists:
SELECT COUNT(*) FROM cached_cocktail WHERE id = ?;

touch:
UPDATE cached_cocktail SET last_accessed = :lastAccessed WHERE id = :id;

selectAll:
SELECT id, payload FROM cached_cocktail ORDER BY last_accessed;

selectByCategory:
SELECT id, payload FROM cached_cocktail
WHERE category = :category
ORDER BY last_accessed;

selectByCategoryOrUncategorized:
SELECT id, payload FROM cached_cocktail
WHERE category = :category OR category IS NULL
ORDER BY last_accessed;

count:
SELECT COUNT(*) FROM cached_cocktail;

maxLastAccessed:
SELECT MAX(last_accessed) AS value FROM cached_cocktail;

deleteById:
DELETE FROM cached_cocktail WHERE id = ?;

deleteCachedBefore:
DELETE FROM cached_cocktail WHERE cached_at < :cutoff;

-- LRU eviction: keep only the :capacity most recently accessed rows.
trimToCapacity:
DELETE FROM cached_cocktail
WHERE id NOT IN (
    SELECT id FROM cached_cocktail ORDER BY last_accessed DESC LIMIT :capacity
);
