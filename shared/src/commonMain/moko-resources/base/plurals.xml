<?xml version="1.0" encoding="utf-8"?>
<!--
    Count-dependent copy (see strings.xml in this folder for conventions).
    Every language must provide the quantities its plural rules need;
    English uses "one" and "other". The count is also format argument %1$d.
-->
<resources>
    <plural name="review_count">
        <item quantity="one">(%1$d review)</item>
        <item quantity="other">(%1$d reviews)</item>
    </plural>
    <plural name="cart_badge_a11y">
        <item quantity="one">%1$d item in cart</item>
        <item quantity="other">%1$d items in cart</item>
    </plural>
</resources>
