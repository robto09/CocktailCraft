<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- Languages the app is localized into. The strings themselves live in
	     the shared module (shared/src/commonMain/moko-resources) and ship in
	     the copied "CocktailCraft:shared.bundle"; add a language here when
	     adding its strings.xml there (see README "Localization"). -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Privacy Usage Descriptions -->
	<key>NSNetworkVolumesUsageDescription</key>
	<string>CocktailCraft needs network access to fetch cocktail recipes and images.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>CocktailCraft may access local network for enhanced functionality.</string>
	<!-- Deep links from the home-screen widgets:
	     cocktailcraft://cocktail/{id} (see WidgetBridge.swift) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.cocktailcraft.CocktailCraft</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cocktailcraft</string>
			</array>
		</dict>
	</array>
	<!-- iOS 18.5 Compatibility -->
	<key>NSSupportsLiveActivities</key>
	<false/>
	<key>NSUserTrackingUsageDescription</key>
	<string>CocktailCraft respects your privacy and does not track users across apps.</string>
	<!-- App Transport Security: platform defaults (HTTPS only, system
	     trust). No certificate pinning, on purpose: TheCocktailDB is a public,
	     unauthenticated API (no credentials or user data go to it), so a pin
	     protects nothing secret, and NSPinnedDomains has no expiry — pinning
	     the CA pool Cloudflare picks and rotates on its own schedule would
	     cut the app off the network whenever that pool changed, until an app
	     update shipped. Android likewise has no pins
	     (androidApp/src/main/res/xml/network_security_config.xml). -->
</dict>
</plist>
